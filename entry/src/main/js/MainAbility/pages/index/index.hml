<div class="container">
    <div class="button-wrapper">
    <!-- 上方：主按钮 -->
        <div class="start-btn" onclick="openChat">
            <text class="start-text">开启对话</text>
        </div>

    <!-- 下方：设置按钮 -->
        <div class="settings-btn" onclick="openSettings">
            <text class="settings-text">设置</text>
        </div>
    </div>
</div>